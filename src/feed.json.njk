---
permalink: /feed.json
eleventyExcludeFromCollections: true
---
{%- set items = [] -%}
{%- for t in timeline %}{% if t.state != "future" %}{% set _n = items.push({
  "id": "zt-milestone-" + t.date + "-" + loop.index,
  "url": ("/#t-" + t.date) | absUrl,
  "title": t.title,
  "content_text": t.when + " — " + t.text,
  "date_published": t.date | isoDate,
  "tags": [t.thread]
}) %}{% endif %}{% endfor -%}
{{ {
  "version": "https://jsonfeed.org/version/1.1",
  "title": "Zachery Taylor — milestones",
  "home_page_url": "/" | absUrl,
  "feed_url": "/feed.json" | absUrl,
  "description": "Milestones from the story so far: work, licensure, writing, and life.",
  "authors": [{ "name": "Zachery Taylor", "url": "/" | absUrl }],
  "language": "en-US",
  "items": items
} | json | safe }}
