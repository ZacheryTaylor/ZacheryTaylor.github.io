---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Zachery Taylor — milestones</title>
    <link>{{ "/" | absUrl }}</link>
    <atom:link href="{{ '/feed.xml' | absUrl }}" rel="self" type="application/rss+xml"/>
    <description>Milestones from the story so far: work, licensure, writing, and life. New entries appear when the timeline is updated.</description>
    <language>en-us</language>
    <lastBuildDate>{{ site.buildTime | rfc822 }}</lastBuildDate>
    {%- for t in timeline %}{% if t.state != "future" %}
    <item>
      <title>{{ t.title }}</title>
      <link>{{ ("/#t-" + t.date) | absUrl }}</link>
      <guid isPermaLink="false">zt-milestone-{{ t.date }}-{{ loop.index }}</guid>
      <pubDate>{{ t.date | rfc822 }}</pubDate>
      <category>{{ t.thread }}</category>
      <description>{{ t.when }} — {{ t.text }}</description>
    </item>
    {%- endif %}{% endfor %}
  </channel>
</rss>
