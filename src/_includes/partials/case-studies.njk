{#- Civil case-study sheets, from civil-work-data.js -> caseStudies.
    Empty `title` = blank "in preparation" sheet. -#}
{%- set studies = civil.caseStudies or [] -%}
{%- if studies.length %}
<div class="cs-wrap">
  <div class="cs-head">
    <h3 class="cs-title">Project case studies</h3>
    <p>Selected projects will be written up here as full sheets once they’re public and cleared to share.</p>
  </div>
  <ul class="cs-grid">
    {%- for cs in studies %}
    {%- if cs.title %}
    <li class="cs-sheet cs-filled reveal">
      <div class="cs-body">
        {%- if cs.image %}<div class="cs-media">{% picture cs.image, cs.title, "card" %}</div>{% endif %}
        <p class="cs-type">{{ cs.type }}</p>
        <h4>{% if cs.url %}<a href="{{ cs.url }}">{{ cs.title }}</a>{% else %}{{ cs.title }}{% endif %}</h4>
        {%- if cs.summary %}<p>{{ cs.summary }}</p>{% endif %}
        {%- if cs.scope and cs.scope.length %}<ul class="chips">{% for c in cs.scope %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
      </div>
      <div class="cs-tb" aria-hidden="true"><span><em>Project</em>{{ cs.title | truncate(28) }}</span><span><em>Status</em>Published</span><span><em>Sheet</em>{{ cs.sheet }}</span></div>
    </li>
    {%- else %}
    <li class="cs-sheet cs-blank reveal">
      <div class="cs-body">
        <span class="cs-crop" aria-hidden="true"></span>
        <p class="cs-type">{{ cs.type }}</p>
        <p class="cs-soon">Case study<br><em>coming soon</em></p>
      </div>
      <div class="cs-tb"><span><em>Project</em>To be announced</span><span><em>Status</em>In preparation</span><span><em>Sheet</em>{{ cs.sheet }}</span></div>
    </li>
    {%- endif %}
    {%- endfor %}
  </ul>
</div>
{%- endif %}
