{%- set links = [
  { key: "civil", href: "/civil.html", label: "Civil Work", sheet: "C-101" },
  { key: "projects", href: "/academic.html", label: "Projects", sheet: "M-201" },
  { key: "life", href: "/personal.html", label: "Life & Interests", sheet: "L-301" },
  { key: "bookshelf", href: "/bookshelf.html", label: "Bookshelf", sheet: "L-320", sub: true },
  { key: "book", href: "/book.html", label: "The Book", sheet: "W-401" }
] -%}
<header class="site-nav">
  <div class="inner">
    {%- set lockupSvg = site.monogram | lockup %}
    {%- if lockupSvg %}
    <a class="brand brand--lockup" href="/">
      <span class="lockup">{{ lockupSvg | safe }}</span>
      <span class="visually-hidden">Zachery Taylor, Civil Designer · EI</span>
    </a>
    {%- else %}
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">{{ site.monogram | monogram | safe }}</span>
      <span class="brand-name">Zachery Taylor<small>Civil Designer · EI</small></span>
    </a>
    {%- endif %}
    <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Dark theme" title="Toggle dark theme" hidden>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.6A8.4 8.4 0 0 1 9.4 4a8.4 8.4 0 1 0 10.6 10.6z"/><path d="M16.5 3.5v3M15 5h3" stroke-linecap="round"/></svg>
    </button>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="nav-toggle-label">Menu</span>
    </button>
    <nav class="nav-menu" id="nav-menu" aria-label="Primary">
      <ul class="nav-links">
        {%- for l in links %}
        <li{% if l.sub %} class="nav-sub"{% endif %}><a href="{{ l.href }}" data-sheet="{{ l.sheet }}"{% if navKey == l.key %} aria-current="page"{% endif %}>{{ l.label }}</a></li>
        {%- endfor %}
        <li class="nav-cta"><a href="/#contact" data-sheet="">Contact</a></li>
      </ul>
    </nav>
    <div class="nav-scrim" aria-hidden="true"></div>
  </div>
</header>
