{#- Contact form ("Send a message"). Configure in site.config.js -> contactForm { provider, key }.
    With a key it posts to Web3Forms or Formspree (JS: in place, no page change; no JS: the
    provider's own thank-you page). Without a key, or if sending fails, the visitor's email app
    opens with the message pre-filled (mailto fallback). Honeypot fields stop simple bots;
    with contactForm.hcaptcha, Web3Forms' free hCaptcha is required before sending. -#}
{%- set cf = site.contactForm or {} -%}
{%- set cfKey = cf.key | trim -%}
{%- set isW3F = cf.provider == "web3forms" -%}
{%- set cfAction = ("https://api.web3forms.com/submit" if isW3F else "https://formspree.io/f/" + cfKey) if cfKey else "" -%}
<form class="form card contact-form" method="post"
      {%- if cfAction %} action="{{ cfAction }}"{% endif %}
      data-fallback-email="{{ site.author.email }}" data-subject="Hello from your website"
      data-configured="{{ 'true' if cfAction else 'false' }}" data-ajax="true"
      data-success="Thanks — your message is on its way. I'll reply by email.">
  <h3>Send a message</h3>
  <div class="form-row">
    <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" required></div>
    <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required></div>
  </div>
  <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required></textarea></div>
  {%- if cfAction and isW3F %}
  <input type="hidden" name="access_key" value="{{ cfKey }}">
  <input type="hidden" name="subject" value="Website message">
  <input type="hidden" name="from_name" value="{{ site.author.name }} website">
  {%- else %}
  <input type="hidden" name="_subject" value="Website message">
  {%- endif %}
  {#- Honeypots: invisible to people (and screen readers); bots fill every field. -#}
  <div class="hp" aria-hidden="true">
    <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off"></label>
    <label>Don't tick this <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off"></label>
  </div>
  {%- if cfAction and isW3F and cf.hcaptcha %}
  {#- Web3Forms' free hCaptcha (their shared free-plan site key). site.js loads it lazily. -#}
  <div class="captcha-slot" data-sitekey="50b2fe65-b00b-4b9e-ad62-3ba471098be2"></div>
  {%- endif %}
  <div class="btn-row"><button class="btn btn-primary" type="submit">Send message</button></div>
  <p class="form-note">Prefer email? <a href="mailto:{{ site.author.email }}">{{ site.author.email }}</a>
    {%- if not cfAction and site.isStaging %} <span class="pending-badge" title="Set site.config.js → contactForm.key">Form backend pending — one free key</span>{% endif %}</p>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
