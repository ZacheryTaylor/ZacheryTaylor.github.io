{%- set pageTitle = (title + " | " + site.title) if title and not titleIsFull else (title or (site.title + " — Civil Designer, EI · Pensacola")) -%}
{%- set pageDesc = (description or site.description) | truncate(160) -%}
{%- set canonical = page.url | absUrl -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
{%- if not site.indexable or noindex %}
<!-- STAGING: keep out of search results. Built from a non-live repo; see site.config.js -> indexable -->
<meta name="robots" content="noindex, nofollow">
{%- endif %}
<meta name="author" content="{{ site.author.name }}">
<meta name="theme-color" content="#f3f0e8">
<meta name="color-scheme" content="light">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
{%- set ogImg = ogImagePath or "/assets/brand/og-default.png" %}
<meta property="og:image" content="{{ ogImg | absUrl }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogImageAlt or (site.title + ' — civil designer, builder, writer') }}">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ ogImg | absUrl }}">

<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }} — milestones" href="/feed.xml">
<link rel="alternate" type="application/feed+json" title="{{ site.title }} — milestones" href="/feed.json">
<link rel="preload" href="/assets/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<style>{{ ["assets/css/site.css"].concat(extraCss or []) | inlineCss | safe }}</style>
<script>document.documentElement.classList.replace("no-js","js");</script>
{%- include "partials/jsonld.njk" %}
{%- if site.goatcounter %}
<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{%- else %}
<!-- GoatCounter analytics: disabled. Set `goatcounter` in site.config.js to your site code to enable. -->
{%- endif %}
