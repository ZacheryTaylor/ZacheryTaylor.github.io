    <text x="430" y="184" text-anchor="end" dx="-16">INL-1</text>
    <text x="330" y="386" fill-opacity=".7">POND A</text>
    <text x="440" y="196">TC 31.2</text>
    <text x="258" y="28" fill-opacity=".55">N 83°29'E 195.4'</text>
