  <g class="fade" style="--d:2.2s" fill="none" stroke="currentColor" stroke-opacity=".85">
    <circle cx="446" cy="424" r="14" stroke-width="1.2"/>
    <path d="M446 406 L452 428 L446 424 L440 428 Z" fill="currentColor" fill-opacity=".85"/>
