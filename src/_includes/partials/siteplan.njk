      <path d="M296 200 H420"/><path d="M296 246 H420"/>
      <path d="M306 200 V222 M322 200 V222 M338 200 V222 M354 200 V222 M370 200 V222 M386 200 V222 M402 200 V222"/>
      <path d="M306 224 V246 M322 224 V246 M338 224 V246 M354 224 V246 M370 224 V246 M386 224 V246 M402 224 V246"/>
