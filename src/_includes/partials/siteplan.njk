    <path class="flow" stroke="#e0bd80" stroke-width="2" d="M430 186 V258 L360 338"/>
    <rect class="fade" style="--d:1.8s" x="424" y="180" width="12" height="12" stroke-opacity=".95" stroke-width="1.4"/>
    <rect class="fade" style="--d:1.9s" x="424" y="252" width="12" height="12" stroke-opacity=".95" stroke-width="1.4"/>
