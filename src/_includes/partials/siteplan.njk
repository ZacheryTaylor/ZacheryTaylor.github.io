{#- Animated blueprint site-plan accent for the hero panel. Decorative. -#}
<svg class="siteplan" viewBox="0 0 480 470" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sp-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0.45" stop-color="#041d36" stop-opacity="0"/>
      <stop offset="1" stop-color="#041d36" stop-opacity="0.92"/>
