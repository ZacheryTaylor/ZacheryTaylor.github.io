    <path class="draw" style="--len:420;--d:1.2s" stroke-opacity=".9" stroke-width="1.6" d="M292 360 C 318 330, 392 334, 414 356 C 436 380, 404 414, 356 412 C 312 410, 272 392, 292 360 Z"/>
