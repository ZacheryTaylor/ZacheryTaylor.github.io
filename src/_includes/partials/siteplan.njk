    <!-- drive aisle / roadway -->
    <path class="draw" style="--len:500;--d:.6s" stroke-opacity=".7" stroke-width="1.4" d="M236 272 C 300 268, 380 270, 470 266"/>
    <path class="draw" style="--len:500;--d:.7s" stroke-opacity=".7" stroke-width="1.4" d="M236 296 C 300 292, 380 294, 470 290"/>
