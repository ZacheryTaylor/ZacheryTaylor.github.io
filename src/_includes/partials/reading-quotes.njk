{#- Reading & quotes: the quote deck (flashcards + search/filters + list view)
    and the books behind it, in one place. Enhanced by /assets/js/quotes.js;
    without JavaScript the full quote list is shown instead of the deck. -#}
{%- import "quote-card.njk" as qc with context -%}
{%- set first = quotes.deck[0] %}
{%- set qproj = null %}{% for p in projects.life %}{% if p.id == "quote-bank-export" %}{% set qproj = p %}{% endif %}{% endfor %}
<section class="band reading-band" id="reading" aria-labelledby="reading-title">
  <div class="wrap">
    <span id="quotes" class="anchor-alias" aria-hidden="true"></span>
    {{ ui.sectionLabel("L-310", "Reading & quotes") }}
    <h2 id="reading-title">Lines worth <em>copying by hand.</em></h2>
    <p class="section-intro">{{ quotes.count }} quotes from more than a hundred books, logged since 2020 — one card at a time. Starred ones are favorites. Search, filter by topic or book, or <a href="/bookshelf.html">browse the bookshelf</a> they came from.</p>

    <div class="qd" id="quote-deck" data-total="{{ quotes.count }}" data-hash="true">
      <div class="qd-controls">
        <label class="visually-hidden" for="qd-search">Search quotes</label>
        <input type="search" id="qd-search" placeholder="Search quotes, authors, books…" autocomplete="off" enterkeyhint="search">
        <label class="visually-hidden" for="qd-source">Filter by source</label>
        <select id="qd-source">
          <option value="">All sources ({{ quotes.origins.length }})</option>
          {%- for o in quotes.origins %}<option value="{{ o.origin }}">{{ o.origin }} ({{ o.count }})</option>{% endfor %}
        </select>
        <div class="qd-view" role="group" aria-label="View">
          <button type="button" class="qd-view-btn" data-view="card" aria-pressed="true">Card</button>
          <button type="button" class="qd-view-btn" data-view="list" aria-pressed="false">List</button>
        </div>
      </div>
      <div class="qd-chips" role="group" aria-label="Filter by topic">
        <button type="button" class="qd-chip" data-topic="" aria-pressed="true">All</button>
        <button type="button" class="qd-chip qd-chip-fav" data-topic="favorite" aria-pressed="false"><span aria-hidden="true">★</span> Favorites <span class="n">{{ quotes.favorites.length }}</span></button>
        {%- for t in quotes.topics %}
        <button type="button" class="qd-chip" data-topic="{{ t.tag }}" aria-pressed="false">{{ t.tag | capitalize }} <span class="n">{{ t.count }}</span></button>
        {%- endfor %}
      </div>
      <p class="qd-status" id="qd-status" aria-live="polite">All {{ quotes.count }} quotes, newest first.</p>

      {{ qc.card(first, 1, quotes.count, "qd", bookshelf) }}

      {#- List view + no-JS fallback: every quote, newest first -#}
      <ol class="qd-list" id="qd-list" aria-label="Quotes">
        {%- for q in quotes.deck %}
        <li id="{{ quotes.anchorOf[q.id] }}" data-id="{{ q.id }}" data-origin="{{ q.origin }}" data-date="{{ q.date }}" data-tags="{{ (q.tags or []) | join(' ') }}"{% if q.favorite %} data-fav{% endif %}{% set b = bookshelf.byOrigin[q.origin] %}{% if b %} data-book="{{ b.id }}"{% endif %}>
          <a href="#{{ quotes.anchorOf[q.id] }}"><span class="qd-list-text">“{{ q.quote }}”</span><span class="qd-list-meta">{{ q.origin }}{% if q.favorite %} <span class="star" role="img" aria-label="Favorite">★</span>{% endif %}</span></a>
        </li>
        {%- endfor %}
      </ol>
      <p class="qd-empty" id="qd-empty" hidden>No quotes match. <button type="button" class="qd-clear link-btn">Clear filters</button></p>
      <p class="qd-more" id="qd-more" hidden><button class="btn" type="button">Show more</button></p>
    </div>

    {#- The books behind the quotes: tap a spine to read its quotes on the card -#}
    <div class="reading-shelf">
      <div class="reading-shelf-head">
        <h3>The books behind the quotes</h3>
        <a class="text-link" href="/bookshelf.html">Open the bookshelf</a>
      </div>
      <div class="shelf shelf-mini" role="group" aria-label="Books — choose one to read its quotes">
        <ul class="spines">
          {%- for b in bookshelf.books %}{% if b.quoteCount %}
          <li><button type="button" class="spine spine-{{ b.color }}" data-origin="{{ b.origin }}" aria-pressed="false" style="--h: {{ (b.height * 0.62) | round }}px; --w: {{ (b.width * 0.8) | round }}px" title="{{ b.title }} — {{ b.quoteCount }} quotes">
            <span class="spine-title">{{ b.title }}</span>
            <span class="visually-hidden">by {{ b.author }}, {{ b.quoteCount }} quotes</span>
            <span class="spine-mark" aria-hidden="true"></span>
          </button></li>
          {%- endif %}{% endfor %}
        </ul>
      </div>
      <p class="reading-foot">
        {%- if qproj %}<a class="text-link" href="{{ qproj.url }}" data-dialog="dlg-{{ qproj.slug }}" aria-haspopup="dialog">About the quote bank project</a>{% endif %}
      </p>
    </div>
  </div>
</section>
